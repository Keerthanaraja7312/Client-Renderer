# Backend origin (FastAPI). Used by every api/*.ts file.
VITE_DATASTORE_API_URL=http://127.0.0.1:8000
# Same backend; read by hooks/useComponentData (utils/env.ts).
VITE_API_BASE=http://127.0.0.1:8000
# Optional: page shown at "/" (a published page slug).
VITE_DEFAULT_PAGE=
# Set to "false" if your data endpoints are public and no login screen is wanted.
VITE_REQUIRE_LOGIN=true
